{% extends 'base.html.twig' %}

{% block title %}
    Mon panier
{% endblock %}

{% block body %}

<div class="container">

    <h1>Mon panier</h1>

    {% if paniers is empty %}

        <p>Votre panier est vide.</p>

    {% else %}

        <div class="panier">

            {% for panier in paniers %}

                {% set produit = panier.produit %}

                <div class="article-panier">

                    <div class="article-informations">

                        <h2>
                            <a href="{{ path('app_produit', {'id': produit.id}) }}">
                                {{ produit.description }}
                            </a>
                        </h2>

                        <p>
                            Prix unitaire :
                            <strong>{{ produit.prix }} €</strong>
                        </p>

                        <div class="quantite">

                            <span>Quantité :</span>

                            <form method="post" action="{{ path('app_panier_remove', {'id': panier.id}) }}">
                                <button type="submit">
                                    −
                                </button>
                            </form>

                            <strong>
                                {{ panier.qte }}
                            </strong>

                            <form method="post" action="{{ path('app_panier_add', {'id': panier.id}) }}">
                                <button type="submit">
                                    +
                                </button>
                            </form>

                        </div>

                        <p>
                            Total :
                            <strong>
                                {{ (panier.qte * produit.prix)|number_format(2, ',', ' ') }} €
                            </strong>
                        </p>

                    </div>

                </div>

                <hr>

            {% endfor %}

            <div class="panier-total">

                <h2>
                    Total du panier :
                    {{ total|number_format(2, ',', ' ') }} €
                </h2>

                <button type="button">
                    Passer la commande
                </button>

            </div>

        </div>

    {% endif %}

</div>

{% endblock %}