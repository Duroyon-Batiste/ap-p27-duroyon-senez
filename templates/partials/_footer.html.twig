{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/footer.css') }}">
{% endblock %}

<footer class="site-footer">
    <div class="footer-container">
        <div class="footer-brand">
            <a href="{{ path('app_accueil') }}" class="site-logo footer-logo">
                ALL4SPORT
            </a>

            <p>
                Retrouvez les équipements adaptés à votre pratique sportive.
            </p>
        </div>

        <div class="footer-column">
            <h3>Navigation</h3>
            <a href="{{ path('app_accueil') }}">Accueil</a>
            <a href="{{ path('app_accueil') }}#produits">Nos produits</a>
            {% if app.user %}
                <a href="{{ path('app_panier') }}">Mon panier</a>
                <a href="{{ path('app_suivi_commandes') }}">Mes commandes</a>
            {% endif %}
        </div>

        <div class="footer-column">
            <h3>Informations</h3>
            <a href="#">Mentions légales</a>
            <a href="#">Politique de confidentialité</a>
            <a href="#">Conditions générales de vente</a>
        </div>
    </div>

    <div class="footer-bottom">
        <p>
            &copy; {{ "now"|date("Y") }} ALL4SPORT.
            Tous droits réservés.
        </p>
    </div>
</footer>